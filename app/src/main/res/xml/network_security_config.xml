<?xml version="1.0" encoding="utf-8"?>
<!--
    HTTPS everywhere, except for the local json-server used as the simulated monitoring API.
    localhost: json-server reached through `adb reverse tcp:3000 tcp:3000` (default).
    10.0.2.2: the development PC as seen from the Android emulator (alternative).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
